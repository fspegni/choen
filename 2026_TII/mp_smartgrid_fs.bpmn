<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_SmartGrid_IoT_Choreo" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn2:message id="Msg_AMI_Request" name="Request AMI Snapshot" />
  <bpmn2:message id="Msg_Meter_Poll" name="Poll Interval Data" />
  <bpmn2:message id="Msg_Meter_Data" name="Meter Data + Outage Flags" />
  <bpmn2:message id="Msg_Forecast" name="Nowcast + Short-Term Forecast" />
  <bpmn2:message id="Msg_Flex_Req" name="Flex Activation Request (kW/kVAR)" />
  <bpmn2:message id="Msg_DER_Dispatch" name="Dispatch Setpoints" />
  <bpmn2:message id="Msg_DR_Start" name="Start DR Event" />
  <bpmn2:message id="Msg_DR_Notify" name="DR Command / Customer Notify" />
  <bpmn2:message id="Msg_Switching" name="Execute Switching Plan" />
  <bpmn2:message id="Msg_VoltVAR" name="Volt-VAR / Reactive Request" />
  <bpmn2:message id="Msg_Island_Auth" name="Authorize Islanding Readiness" />
  <bpmn2:message id="Msg_Island_Handshake" name="Islanding / Sync Handshake" />
  <bpmn2:message id="Msg_PMU_Verify" name="Stability Verification" />
  <bpmn2:message id="Msg_Post_AMI" name="Post-Action AMI Confirmation" />
  <bpmn2:message id="Msg_RampDown" name="Ramp-Down / Return to Schedule" />
  <bpmn2:message id="Msg_DR_End" name="End DR Event" />
  <bpmn2:message id="Msg_Status_OK" name="Status OK / Update Interface" />
  <bpmn2:message id="Msg_Anomaly" name="Anomaly Report (Telemetry Context)" />
  <bpmn2:message id="Msg_Contain" name="Containment Action / Clearance" />
  <bpmn2:message id="Msg_Ticket" name="Trouble Ticket + Location" />
  <bpmn2:message id="Msg_Onsite" name="Onsite Safe-to-Operate" />
  <bpmn2:message id="Msg_Restore" name="Restoration Confirmation" />
  <bpmn2:choreography id="Choreo_SmartGrid" name="IoT Smart Grid Choreography (AND / OR / XOR + Loop)">
    <bpmn2:participant id="Part_SCADA" name="DSO Control Center (SCADA/EMS)" />
    <bpmn2:participant id="Part_HES" name="AMI Head-End System (HES)" />
    <bpmn2:participant id="Part_Meters" name="Smart Meters (AMI Field)" />
    <bpmn2:participant id="Part_Weather" name="Weather / Forecast Service" />
    <bpmn2:participant id="Part_DER" name="DER Aggregator (VPP)" />
    <bpmn2:participant id="Part_MGC" name="Microgrid Controller (MGC)" />
    <bpmn2:participant id="Part_IED" name="Substation Automation (IED/RTU)" />
    <bpmn2:participant id="Part_PMU" name="PMU/WAMS Platform" />
    <bpmn2:participant id="Part_DR" name="Demand Response Platform" />
    <bpmn2:participant id="Part_SOC" name="Cybersecurity SOC" />
    <bpmn2:participant id="Part_Crew" name="Field Maintenance Dispatch" />
    <bpmn2:participant id="Part_Market" name="Market/TSO Interface" />
    <bpmn2:messageFlow id="MF1" sourceRef="Part_SCADA" targetRef="Part_HES" messageRef="Msg_AMI_Request" />
    <bpmn2:messageFlow id="MF2" sourceRef="Part_HES" targetRef="Part_Meters" messageRef="Msg_Meter_Poll" />
    <bpmn2:messageFlow id="MF3" sourceRef="Part_Meters" targetRef="Part_HES" messageRef="Msg_Meter_Data" />
    <bpmn2:messageFlow id="MF4" sourceRef="Part_Weather" targetRef="Part_SCADA" messageRef="Msg_Forecast" />
    <bpmn2:messageFlow id="MF5" sourceRef="Part_SCADA" targetRef="Part_DER" messageRef="Msg_Flex_Req" />
    <bpmn2:messageFlow id="MF6" sourceRef="Part_DER" targetRef="Part_MGC" messageRef="Msg_DER_Dispatch" />
    <bpmn2:messageFlow id="MF7" sourceRef="Part_SCADA" targetRef="Part_DR" messageRef="Msg_DR_Start" />
    <bpmn2:messageFlow id="MF8" sourceRef="Part_DR" targetRef="Part_Meters" messageRef="Msg_DR_Notify" />
    <bpmn2:messageFlow id="MF9" sourceRef="Part_SCADA" targetRef="Part_IED" messageRef="Msg_Switching" />
    <bpmn2:messageFlow id="MF10" sourceRef="Part_SCADA" targetRef="Part_DER" messageRef="Msg_VoltVAR" />
    <bpmn2:messageFlow id="MF11" sourceRef="Part_SCADA" targetRef="Part_MGC" messageRef="Msg_Island_Auth" />
    <bpmn2:messageFlow id="MF12" sourceRef="Part_MGC" targetRef="Part_IED" messageRef="Msg_Island_Handshake" />
    <bpmn2:messageFlow id="MF13" sourceRef="Part_PMU" targetRef="Part_SCADA" messageRef="Msg_PMU_Verify" />
    <bpmn2:messageFlow id="MF14" sourceRef="Part_SCADA" targetRef="Part_HES" messageRef="Msg_Post_AMI" />
    <bpmn2:messageFlow id="MF15" sourceRef="Part_SCADA" targetRef="Part_DER" messageRef="Msg_RampDown" />
    <bpmn2:messageFlow id="MF16" sourceRef="Part_SCADA" targetRef="Part_DR" messageRef="Msg_DR_End" />
    <bpmn2:messageFlow id="MF17" sourceRef="Part_SCADA" targetRef="Part_Market" messageRef="Msg_Status_OK" />
    <bpmn2:messageFlow id="MF18" sourceRef="Part_SCADA" targetRef="Part_SOC" messageRef="Msg_Anomaly" />
    <bpmn2:messageFlow id="MF19" sourceRef="Part_SOC" targetRef="Part_SCADA" messageRef="Msg_Contain" />
    <bpmn2:messageFlow id="MF20" sourceRef="Part_SCADA" targetRef="Part_Crew" messageRef="Msg_Ticket" />
    <bpmn2:messageFlow id="MF21" sourceRef="Part_Crew" targetRef="Part_IED" messageRef="Msg_Onsite" />
    <bpmn2:messageFlow id="MF22" sourceRef="Part_Crew" targetRef="Part_SCADA" messageRef="Msg_Restore" />
    <bpmn2:endEvent id="EndEvent">
      <bpmn2:incoming>SF_END</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:parallelGateway id="G_AND_SPLIT" name="AND">
      <bpmn2:incoming>SF4B</bpmn2:incoming>
      <bpmn2:outgoing>SF5</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_1mne0rl</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:parallelGateway id="G_AND_JOIN">
      <bpmn2:incoming>SF6B</bpmn2:incoming>
      <bpmn2:incoming>Flow_1bezv1x</bpmn2:incoming>
      <bpmn2:outgoing>SF7</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:inclusiveGateway id="G_OR_SPLIT">
      <bpmn2:incoming>SF7</bpmn2:incoming>
      <bpmn2:outgoing>SF8</bpmn2:outgoing>
      <bpmn2:outgoing>SF_OR_LOW</bpmn2:outgoing>
      <bpmn2:outgoing>SF_OR_UP1</bpmn2:outgoing>
    </bpmn2:inclusiveGateway>
    <bpmn2:inclusiveGateway id="G_OR_JOIN">
      <bpmn2:incoming>SF9</bpmn2:incoming>
      <bpmn2:incoming>SF_OR_UP3</bpmn2:incoming>
      <bpmn2:incoming>Flow_1f34xg5</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0t9812v</bpmn2:outgoing>
    </bpmn2:inclusiveGateway>
    <bpmn2:exclusiveGateway id="G_XOR" name="XOR Stable?">
      <bpmn2:incoming>SF12B</bpmn2:incoming>
      <bpmn2:outgoing>SF_OK1</bpmn2:outgoing>
      <bpmn2:outgoing>SF_NOK1</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:choreographyTask id="CT1" name="Request AMI Snapshot" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF1</bpmn2:incoming>
      <bpmn2:outgoing>SF2</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_HES</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF1</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT2" name="Poll Interval Data" initiatingParticipantRef="Part_HES">
      <bpmn2:incoming>SF2</bpmn2:incoming>
      <bpmn2:outgoing>SF3</bpmn2:outgoing>
      <bpmn2:participantRef>Part_HES</bpmn2:participantRef>
      <bpmn2:participantRef>Part_Meters</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF2</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT3" name="Send Meter Data + Flags" initiatingParticipantRef="Part_Meters">
      <bpmn2:incoming>SF3</bpmn2:incoming>
      <bpmn2:outgoing>SF4</bpmn2:outgoing>
      <bpmn2:participantRef>Part_Meters</bpmn2:participantRef>
      <bpmn2:participantRef>Part_HES</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF3</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT4" name="Provide Nowcast Forecast" initiatingParticipantRef="Part_Weather">
      <bpmn2:incoming>SF4</bpmn2:incoming>
      <bpmn2:outgoing>SF4B</bpmn2:outgoing>
      <bpmn2:participantRef>Part_Weather</bpmn2:participantRef>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF4</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:sequenceFlow id="SF4B" sourceRef="CT4" targetRef="G_AND_SPLIT" />
    <bpmn2:choreographyTask id="CT5" name="Request Flex Activation" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF5</bpmn2:incoming>
      <bpmn2:outgoing>SF6</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_DER</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF5</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT6" name="Dispatch DER Setpoints" initiatingParticipantRef="Part_DER">
      <bpmn2:incoming>SF6</bpmn2:incoming>
      <bpmn2:outgoing>SF6B</bpmn2:outgoing>
      <bpmn2:participantRef>Part_DER</bpmn2:participantRef>
      <bpmn2:participantRef>Part_MGC</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF6</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:sequenceFlow id="SF6B" sourceRef="CT6" targetRef="G_AND_JOIN" />
    <bpmn2:choreographyTask id="CT7" name="Start DR Event" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>Flow_1mne0rl</bpmn2:incoming>
      <bpmn2:outgoing>SF_AND_B2</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_DR</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF7</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT8" name="Notify Customers (DR)" initiatingParticipantRef="Part_DR">
      <bpmn2:incoming>SF_AND_B2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1bezv1x</bpmn2:outgoing>
      <bpmn2:participantRef>Part_DR</bpmn2:participantRef>
      <bpmn2:participantRef>Part_Meters</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF8</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT9" name="Execute Switching Plan" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF8</bpmn2:incoming>
      <bpmn2:outgoing>SF9</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_IED</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF9</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT10" name="Request Volt-VAR Support" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF_OR_LOW</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1f34xg5</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_DER</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF10</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT11" name="Authorize Islanding Readiness" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF_OR_UP1</bpmn2:incoming>
      <bpmn2:outgoing>SF_OR_UP2</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_MGC</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF11</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT12" name="Islanding/Sync Handshake" initiatingParticipantRef="Part_MGC">
      <bpmn2:incoming>SF_OR_UP2</bpmn2:incoming>
      <bpmn2:outgoing>SF_OR_UP3</bpmn2:outgoing>
      <bpmn2:participantRef>Part_MGC</bpmn2:participantRef>
      <bpmn2:participantRef>Part_IED</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF12</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT13" name="Stability Verification" initiatingParticipantRef="Part_PMU">
      <bpmn2:incoming>Flow_1073x4g</bpmn2:incoming>
      <bpmn2:outgoing>SF11</bpmn2:outgoing>
      <bpmn2:participantRef>Part_PMU</bpmn2:participantRef>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF13</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT14" name="Post-Action AMI Confirmation" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF11</bpmn2:incoming>
      <bpmn2:outgoing>SF12B</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_HES</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF14</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT15" name="Ramp-Down / Return to Schedule" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF_OK1</bpmn2:incoming>
      <bpmn2:outgoing>SF_OK2</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_DER</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF15</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT16" name="End DR Event" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF_OK2</bpmn2:incoming>
      <bpmn2:outgoing>SF_OK3</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_DR</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF16</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT17_OK" name="Status OK / Update Interface" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF_OK3</bpmn2:incoming>
      <bpmn2:outgoing>SF_END</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_Market</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF17</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT18" name="Report Anomaly to SOC" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF_NOK1</bpmn2:incoming>
      <bpmn2:outgoing>SF_NOK2</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_SOC</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF18</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT19" name="Containment / Clearance" initiatingParticipantRef="Part_SOC">
      <bpmn2:incoming>SF_NOK2</bpmn2:incoming>
      <bpmn2:outgoing>SF_NOK3</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SOC</bpmn2:participantRef>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF19</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT20" name="Dispatch Field Ticket" initiatingParticipantRef="Part_SCADA">
      <bpmn2:incoming>SF_NOK3</bpmn2:incoming>
      <bpmn2:outgoing>SF_NOK4</bpmn2:outgoing>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_Crew</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF20</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT21" name="Onsite Safe-to-Operate" initiatingParticipantRef="Part_Crew">
      <bpmn2:incoming>SF_NOK4</bpmn2:incoming>
      <bpmn2:outgoing>SF_NOK5</bpmn2:outgoing>
      <bpmn2:participantRef>Part_Crew</bpmn2:participantRef>
      <bpmn2:participantRef>Part_IED</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF21</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT22" name="Restoration Confirmation" initiatingParticipantRef="Part_Crew">
      <bpmn2:incoming>SF_NOK5</bpmn2:incoming>
      <bpmn2:outgoing>SF_LOOP</bpmn2:outgoing>
      <bpmn2:participantRef>Part_Crew</bpmn2:participantRef>
      <bpmn2:participantRef>Part_SCADA</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF22</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:sequenceFlow id="SF2" sourceRef="CT1" targetRef="CT2" />
    <bpmn2:sequenceFlow id="SF3" sourceRef="CT2" targetRef="CT3" />
    <bpmn2:sequenceFlow id="SF4" sourceRef="CT3" targetRef="CT4" />
    <bpmn2:sequenceFlow id="SF5" sourceRef="G_AND_SPLIT" targetRef="CT5" />
    <bpmn2:sequenceFlow id="SF6" sourceRef="CT5" targetRef="CT6" />
    <bpmn2:sequenceFlow id="SF_AND_B2" sourceRef="CT7" targetRef="CT8" />
    <bpmn2:sequenceFlow id="SF7" sourceRef="G_AND_JOIN" targetRef="G_OR_SPLIT" />
    <bpmn2:sequenceFlow id="SF8" sourceRef="G_OR_SPLIT" targetRef="CT9" />
    <bpmn2:sequenceFlow id="SF9" sourceRef="CT9" targetRef="G_OR_JOIN" />
    <bpmn2:sequenceFlow id="SF_OR_LOW" sourceRef="G_OR_SPLIT" targetRef="CT10" />
    <bpmn2:sequenceFlow id="SF_OR_UP1" sourceRef="G_OR_SPLIT" targetRef="CT11" />
    <bpmn2:sequenceFlow id="SF_OR_UP2" sourceRef="CT11" targetRef="CT12" />
    <bpmn2:sequenceFlow id="SF_OR_UP3" sourceRef="CT12" targetRef="G_OR_JOIN" />
    <bpmn2:sequenceFlow id="SF11" sourceRef="CT13" targetRef="CT14" />
    <bpmn2:sequenceFlow id="SF12B" sourceRef="CT14" targetRef="G_XOR" />
    <bpmn2:sequenceFlow id="SF_OK1" name="OK" sourceRef="G_XOR" targetRef="CT15" />
    <bpmn2:sequenceFlow id="SF_OK2" sourceRef="CT15" targetRef="CT16" />
    <bpmn2:sequenceFlow id="SF_OK3" sourceRef="CT16" targetRef="CT17_OK" />
    <bpmn2:sequenceFlow id="SF_END" sourceRef="CT17_OK" targetRef="EndEvent" />
    <bpmn2:sequenceFlow id="SF_NOK1" name="NOK" sourceRef="G_XOR" targetRef="CT18" />
    <bpmn2:sequenceFlow id="SF_NOK2" sourceRef="CT18" targetRef="CT19" />
    <bpmn2:sequenceFlow id="SF_NOK3" sourceRef="CT19" targetRef="CT20" />
    <bpmn2:sequenceFlow id="SF_NOK4" sourceRef="CT20" targetRef="CT21" />
    <bpmn2:sequenceFlow id="SF_NOK5" sourceRef="CT21" targetRef="CT22" />
    <bpmn2:sequenceFlow id="SF_LOOP" name="Re-Verify" sourceRef="CT22" targetRef="Gateway_083ji2q" />
    <bpmn2:startEvent id="StartEvent">
      <bpmn2:outgoing>SF1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="SF1" sourceRef="StartEvent" targetRef="CT1" />
    <bpmn2:sequenceFlow id="Flow_1bezv1x" sourceRef="CT8" targetRef="G_AND_JOIN" />
    <bpmn2:sequenceFlow id="Flow_1mne0rl" sourceRef="G_AND_SPLIT" targetRef="CT7" />
    <bpmn2:inclusiveGateway id="Gateway_083ji2q">
      <bpmn2:incoming>Flow_0t9812v</bpmn2:incoming>
      <bpmn2:incoming>SF_LOOP</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1073x4g</bpmn2:outgoing>
    </bpmn2:inclusiveGateway>
    <bpmn2:sequenceFlow id="Flow_0t9812v" sourceRef="G_OR_JOIN" targetRef="Gateway_083ji2q" />
    <bpmn2:sequenceFlow id="Flow_1073x4g" sourceRef="Gateway_083ji2q" targetRef="CT13" />
    <bpmn2:sequenceFlow id="Flow_1f34xg5" sourceRef="CT10" targetRef="G_OR_JOIN" />
  </bpmn2:choreography>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SmartGrid">
    <bpmndi:BPMNPlane id="BPMNPlane_SmartGrid" bpmnElement="Choreo_SmartGrid">
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="3372" y="339" width="36" height="36" />
