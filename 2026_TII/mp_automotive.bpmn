<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_AutoShopFloor_Branched" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn2:message id="Msg_PO" name="Production Order" />
  <bpmn2:message id="Msg_MatReq" name="Material Request" />
  <bpmn2:message id="Msg_AGVTask" name="Pick/Deliver Mission" />
  <bpmn2:message id="Msg_DeliverComp" name="Components Delivered" />
  <bpmn2:message id="Msg_FrameReady" name="Frame Ready" />
  <bpmn2:message id="Msg_FrameTransportReq" name="Transport Request" />
  <bpmn2:message id="Msg_FrameDelivered" name="Frame Delivered" />
  <bpmn2:message id="Msg_StartAssembly" name="Start Assembly" />
  <bpmn2:message id="Msg_WeldProgram" name="Execute Welding Program" />
  <bpmn2:message id="Msg_SendToQuality" name="Send to Quality" />
  <bpmn2:message id="Msg_InspectionResult" name="Inspection Result" />
  <bpmn2:message id="Msg_EnergyWarning" name="Energy Load Warning" />
  <bpmn2:message id="Msg_DelayNotify" name="Delay Notification" />
  <bpmn2:message id="Msg_Reschedule" name="Reschedule Slot" />
  <bpmn2:message id="Msg_Anomaly" name="Anomaly Report" />
  <bpmn2:message id="Msg_MaintApprovalReq" name="Maintenance Approval Request" />
  <bpmn2:message id="Msg_MaintApproved" name="Maintenance Approved" />
  <bpmn2:message id="Msg_TransportBody" name="Transport Request" />
  <bpmn2:message id="Msg_Complete" name="Module Completed" />
  <bpmn2:choreography id="Choreo_Auto_Branched" name="Automotive Multi-Work-Cell Choreography (AND / OR / XOR)">
    <bpmn2:participant id="Part_PPS" name="Prod. Planning System (PPS)" />
    <bpmn2:participant id="Part_CellA" name="Work Cell A - Frame Welding" />
    <bpmn2:participant id="Part_CellB" name="W. C. B - Side Panel Assembly" />
    <bpmn2:participant id="Part_CellC" name="Work Cell C - Roof Assembly" />
    <bpmn2:participant id="Part_RobotA" name="Robot Controller A" />
    <bpmn2:participant id="Part_RobotB" name="Robot Controller B" />
    <bpmn2:participant id="Part_AGV" name="Material Handling (AGV Fleet)" />
    <bpmn2:participant id="Part_WMS" name="Warehouse Mgmt Sys. (WMS)" />
    <bpmn2:participant id="Part_Quality" name="Quality Inspection Cell" />
    <bpmn2:participant id="Part_Maint" name="Maintenance System" />
    <bpmn2:participant id="Part_Energy" name="Energy Management System" />
    <bpmn2:participant id="Part_Supervisor" name="Human Supervisor" />
    <bpmn2:messageFlow id="MF1_PO" sourceRef="Part_PPS" targetRef="Part_CellA" messageRef="Msg_PO" />
    <bpmn2:messageFlow id="MF2_MatReq" sourceRef="Part_CellA" targetRef="Part_WMS" messageRef="Msg_MatReq" />
    <bpmn2:messageFlow id="MF3_AGVTask" sourceRef="Part_WMS" targetRef="Part_AGV" messageRef="Msg_AGVTask" />
    <bpmn2:messageFlow id="MF4_DeliverComp" sourceRef="Part_AGV" targetRef="Part_CellA" messageRef="Msg_DeliverComp" />
    <bpmn2:messageFlow id="MF5_FrameReady" sourceRef="Part_CellA" targetRef="Part_CellB" messageRef="Msg_FrameReady" />
    <bpmn2:messageFlow id="MF6_FrameTransportReq" sourceRef="Part_CellB" targetRef="Part_AGV" messageRef="Msg_FrameTransportReq" />
    <bpmn2:messageFlow id="MF7_FrameDelivered" sourceRef="Part_AGV" targetRef="Part_CellB" messageRef="Msg_FrameDelivered" />
    <bpmn2:messageFlow id="MF8_StartAssembly" sourceRef="Part_CellB" targetRef="Part_RobotB" messageRef="Msg_StartAssembly" />
    <bpmn2:messageFlow id="MF9_WeldProgram" sourceRef="Part_CellA" targetRef="Part_RobotA" messageRef="Msg_WeldProgram" />
    <bpmn2:messageFlow id="MF10_SendToQuality" sourceRef="Part_CellB" targetRef="Part_Quality" messageRef="Msg_SendToQuality" />
    <bpmn2:messageFlow id="MF11_InspectionResult" sourceRef="Part_Quality" targetRef="Part_CellB" messageRef="Msg_InspectionResult" />
    <bpmn2:messageFlow id="MF12_EnergyWarning" sourceRef="Part_Energy" targetRef="Part_CellC" messageRef="Msg_EnergyWarning" />
    <bpmn2:messageFlow id="MF13_DelayNotify" sourceRef="Part_CellC" targetRef="Part_PPS" messageRef="Msg_DelayNotify" />
    <bpmn2:messageFlow id="MF14_Reschedule" sourceRef="Part_PPS" targetRef="Part_CellA" messageRef="Msg_Reschedule" />
    <bpmn2:messageFlow id="MF15_Anomaly" sourceRef="Part_Quality" targetRef="Part_Maint" messageRef="Msg_Anomaly" />
    <bpmn2:messageFlow id="MF16_MaintApprovalReq" sourceRef="Part_Maint" targetRef="Part_Supervisor" messageRef="Msg_MaintApprovalReq" />
    <bpmn2:messageFlow id="MF17_MaintApproved" sourceRef="Part_Supervisor" targetRef="Part_Maint" messageRef="Msg_MaintApproved" />
    <bpmn2:messageFlow id="MF18_TransportBody" sourceRef="Part_CellC" targetRef="Part_AGV" messageRef="Msg_TransportBody" />
    <bpmn2:messageFlow id="MF19_Complete" sourceRef="Part_AGV" targetRef="Part_PPS" messageRef="Msg_Complete" />
    <bpmn2:startEvent id="StartEvent">
      <bpmn2:outgoing>SF1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:endEvent id="EndEvent">
      <bpmn2:incoming>SF_END</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:parallelGateway id="G_AND_SPLIT">
      <bpmn2:incoming>SF5</bpmn2:incoming>
      <bpmn2:outgoing>SF6</bpmn2:outgoing>
      <bpmn2:outgoing>SF_AND_B</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:parallelGateway id="G_AND_JOIN">
      <bpmn2:incoming>SF10</bpmn2:incoming>
      <bpmn2:incoming>SF_AND_BJ</bpmn2:incoming>
      <bpmn2:outgoing>SF11</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:inclusiveGateway id="G_OR_SPLIT">
      <bpmn2:incoming>SF11</bpmn2:incoming>
      <bpmn2:outgoing>SF12</bpmn2:outgoing>
      <bpmn2:outgoing>SF_OR_E1</bpmn2:outgoing>
    </bpmn2:inclusiveGateway>
    <bpmn2:inclusiveGateway id="G_OR_JOIN">
      <bpmn2:incoming>SF13</bpmn2:incoming>
      <bpmn2:incoming>SF_OR_E3</bpmn2:incoming>
      <bpmn2:outgoing>SF14</bpmn2:outgoing>
    </bpmn2:inclusiveGateway>
    <bpmn2:exclusiveGateway id="G_XOR">
      <bpmn2:incoming>SF15</bpmn2:incoming>
      <bpmn2:outgoing>SF_OK1</bpmn2:outgoing>
      <bpmn2:outgoing>SF_NOK1</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:choreographyTask id="CT1" name="Release Production Order" initiatingParticipantRef="Part_PPS">
      <bpmn2:incoming>SF1</bpmn2:incoming>
      <bpmn2:outgoing>SF2</bpmn2:outgoing>
      <bpmn2:participantRef>Part_PPS</bpmn2:participantRef>
      <bpmn2:participantRef>Part_CellA</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF1_PO</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT2" name="Request Frame Components" initiatingParticipantRef="Part_CellA">
      <bpmn2:incoming>SF2</bpmn2:incoming>
      <bpmn2:outgoing>SF3</bpmn2:outgoing>
      <bpmn2:participantRef>Part_CellA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_WMS</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF2_MatReq</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT3" name="Dispatch Pick/Deliver Mission" initiatingParticipantRef="Part_WMS">
      <bpmn2:incoming>SF3</bpmn2:incoming>
      <bpmn2:outgoing>SF4</bpmn2:outgoing>
      <bpmn2:participantRef>Part_WMS</bpmn2:participantRef>
      <bpmn2:participantRef>Part_AGV</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF3_AGVTask</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT4" name="Deliver Components to Cell A" initiatingParticipantRef="Part_AGV">
      <bpmn2:incoming>SF4</bpmn2:incoming>
      <bpmn2:outgoing>SF5</bpmn2:outgoing>
      <bpmn2:participantRef>Part_AGV</bpmn2:participantRef>
      <bpmn2:participantRef>Part_CellA</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF4_DeliverComp</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT5" name="Notify Frame Ready" initiatingParticipantRef="Part_CellA">
      <bpmn2:incoming>SF6</bpmn2:incoming>
      <bpmn2:outgoing>SF7</bpmn2:outgoing>
      <bpmn2:participantRef>Part_CellA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_CellB</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF5_FrameReady</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT6" name="Request Frame Transport" initiatingParticipantRef="Part_CellB">
      <bpmn2:incoming>SF7</bpmn2:incoming>
      <bpmn2:outgoing>SF8</bpmn2:outgoing>
      <bpmn2:participantRef>Part_CellB</bpmn2:participantRef>
      <bpmn2:participantRef>Part_AGV</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF6_FrameTransportReq</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT7" name="Deliver Frame to Cell B" initiatingParticipantRef="Part_AGV">
      <bpmn2:incoming>SF8</bpmn2:incoming>
      <bpmn2:outgoing>SF9</bpmn2:outgoing>
      <bpmn2:participantRef>Part_AGV</bpmn2:participantRef>
      <bpmn2:participantRef>Part_CellB</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF7_FrameDelivered</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT8" name="Start Side Panel Assembly" initiatingParticipantRef="Part_CellB">
      <bpmn2:incoming>SF9</bpmn2:incoming>
      <bpmn2:outgoing>SF10</bpmn2:outgoing>
      <bpmn2:participantRef>Part_CellB</bpmn2:participantRef>
      <bpmn2:participantRef>Part_RobotB</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF8_StartAssembly</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT9" name="Execute Welding Program" initiatingParticipantRef="Part_CellA">
      <bpmn2:incoming>SF_AND_B</bpmn2:incoming>
      <bpmn2:outgoing>SF_AND_BJ</bpmn2:outgoing>
      <bpmn2:participantRef>Part_CellA</bpmn2:participantRef>
      <bpmn2:participantRef>Part_RobotA</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF9_WeldProgram</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT10" name="Send Assembly to Quality" initiatingParticipantRef="Part_CellB">
      <bpmn2:incoming>Flow_1fo6m6d</bpmn2:incoming>
      <bpmn2:outgoing>SF13</bpmn2:outgoing>
      <bpmn2:participantRef>Part_CellB</bpmn2:participantRef>
      <bpmn2:participantRef>Part_Quality</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF10_SendToQuality</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT11E" name="Energy Load Warning" initiatingParticipantRef="Part_Energy">
      <bpmn2:incoming>SF_OR_E1</bpmn2:incoming>
      <bpmn2:outgoing>SF_OR_E2</bpmn2:outgoing>
      <bpmn2:participantRef>Part_Energy</bpmn2:participantRef>
      <bpmn2:participantRef>Part_CellC</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF12_EnergyWarning</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT12E" name="Notify Delay" initiatingParticipantRef="Part_CellC">
      <bpmn2:incoming>SF_OR_E2</bpmn2:incoming>
      <bpmn2:outgoing>SF_OR_E2B</bpmn2:outgoing>
      <bpmn2:participantRef>Part_CellC</bpmn2:participantRef>
      <bpmn2:participantRef>Part_PPS</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF13_DelayNotify</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT13E" name="Reschedule Slot" initiatingParticipantRef="Part_PPS">
      <bpmn2:incoming>SF_OR_E2B</bpmn2:incoming>
      <bpmn2:outgoing>SF_OR_E3</bpmn2:outgoing>
      <bpmn2:participantRef>Part_PPS</bpmn2:participantRef>
      <bpmn2:participantRef>Part_CellA</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF14_Reschedule</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT11" name="Return Inspection Result" initiatingParticipantRef="Part_Quality">
      <bpmn2:incoming>SF14</bpmn2:incoming>
      <bpmn2:outgoing>SF15</bpmn2:outgoing>
      <bpmn2:participantRef>Part_Quality</bpmn2:participantRef>
      <bpmn2:participantRef>Part_CellB</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF11_InspectionResult</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT12" name="Report Anomaly" initiatingParticipantRef="Part_Quality">
      <bpmn2:incoming>SF_NOK1</bpmn2:incoming>
      <bpmn2:outgoing>SF_NOK2</bpmn2:outgoing>
      <bpmn2:participantRef>Part_Quality</bpmn2:participantRef>
      <bpmn2:participantRef>Part_Maint</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF15_Anomaly</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT13" name="Request Maintenance Approval" initiatingParticipantRef="Part_Maint">
      <bpmn2:incoming>SF_NOK2</bpmn2:incoming>
      <bpmn2:outgoing>SF_NOK3</bpmn2:outgoing>
      <bpmn2:participantRef>Part_Maint</bpmn2:participantRef>
      <bpmn2:participantRef>Part_Supervisor</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF16_MaintApprovalReq</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT14" name="Approve Maintenance" initiatingParticipantRef="Part_Supervisor">
      <bpmn2:incoming>SF_NOK3</bpmn2:incoming>
      <bpmn2:outgoing>SF_LOOP</bpmn2:outgoing>
      <bpmn2:participantRef>Part_Supervisor</bpmn2:participantRef>
      <bpmn2:participantRef>Part_Maint</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF17_MaintApproved</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT15" name="Request Body Transport" initiatingParticipantRef="Part_CellC">
      <bpmn2:incoming>SF_OK1</bpmn2:incoming>
      <bpmn2:outgoing>SF_OK2</bpmn2:outgoing>
      <bpmn2:participantRef>Part_CellC</bpmn2:participantRef>
      <bpmn2:participantRef>Part_AGV</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF18_TransportBody</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:choreographyTask id="CT16" name="Notify Module Completed" initiatingParticipantRef="Part_AGV">
      <bpmn2:incoming>SF_OK2</bpmn2:incoming>
      <bpmn2:outgoing>SF_END</bpmn2:outgoing>
      <bpmn2:participantRef>Part_AGV</bpmn2:participantRef>
      <bpmn2:participantRef>Part_PPS</bpmn2:participantRef>
      <bpmn2:messageFlowRef>MF19_Complete</bpmn2:messageFlowRef>
    </bpmn2:choreographyTask>
    <bpmn2:sequenceFlow id="SF1" sourceRef="StartEvent" targetRef="CT1" />
    <bpmn2:sequenceFlow id="SF2" sourceRef="CT1" targetRef="CT2" />
    <bpmn2:sequenceFlow id="SF3" sourceRef="CT2" targetRef="CT3" />
    <bpmn2:sequenceFlow id="SF4" sourceRef="CT3" targetRef="CT4" />
    <bpmn2:sequenceFlow id="SF5" sourceRef="CT4" targetRef="G_AND_SPLIT" />
    <bpmn2:sequenceFlow id="SF6" sourceRef="G_AND_SPLIT" targetRef="CT5" />
    <bpmn2:sequenceFlow id="SF7" sourceRef="CT5" targetRef="CT6" />
    <bpmn2:sequenceFlow id="SF8" sourceRef="CT6" targetRef="CT7" />
    <bpmn2:sequenceFlow id="SF9" sourceRef="CT7" targetRef="CT8" />
    <bpmn2:sequenceFlow id="SF10" sourceRef="CT8" targetRef="G_AND_JOIN" />
    <bpmn2:sequenceFlow id="SF_AND_B" sourceRef="G_AND_SPLIT" targetRef="CT9" />
    <bpmn2:sequenceFlow id="SF_AND_BJ" sourceRef="CT9" targetRef="G_AND_JOIN" />
    <bpmn2:sequenceFlow id="SF11" sourceRef="G_AND_JOIN" targetRef="G_OR_SPLIT" />
    <bpmn2:sequenceFlow id="SF12" sourceRef="G_OR_SPLIT" targetRef="Gateway_0xnnfmp" />
    <bpmn2:sequenceFlow id="SF13" sourceRef="CT10" targetRef="G_OR_JOIN" />
    <bpmn2:sequenceFlow id="SF_OR_E1" sourceRef="G_OR_SPLIT" targetRef="CT11E" />
    <bpmn2:sequenceFlow id="SF_OR_E2" sourceRef="CT11E" targetRef="CT12E" />
    <bpmn2:sequenceFlow id="SF_OR_E2B" sourceRef="CT12E" targetRef="CT13E" />
    <bpmn2:sequenceFlow id="SF_OR_E3" sourceRef="CT13E" targetRef="G_OR_JOIN" />
    <bpmn2:sequenceFlow id="SF14" sourceRef="G_OR_JOIN" targetRef="CT11" />
    <bpmn2:sequenceFlow id="SF15" sourceRef="CT11" targetRef="G_XOR" />
    <bpmn2:sequenceFlow id="SF_OK1" name="OK" sourceRef="G_XOR" targetRef="CT15" />
    <bpmn2:sequenceFlow id="SF_OK2" sourceRef="CT15" targetRef="CT16" />
    <bpmn2:sequenceFlow id="SF_END" sourceRef="CT16" targetRef="EndEvent" />
    <bpmn2:sequenceFlow id="SF_NOK1" name="NOK" sourceRef="G_XOR" targetRef="CT12" />
    <bpmn2:sequenceFlow id="SF_NOK2" sourceRef="CT12" targetRef="CT13" />
    <bpmn2:sequenceFlow id="SF_NOK3" sourceRef="CT13" targetRef="CT14" />
    <bpmn2:sequenceFlow id="SF_LOOP" name="Rework &#38; Reinspect" sourceRef="CT14" targetRef="Gateway_0xnnfmp" />
    <bpmn2:parallelGateway id="Gateway_0xnnfmp">
      <bpmn2:incoming>SF12</bpmn2:incoming>
      <bpmn2:incoming>SF_LOOP</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1fo6m6d</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:sequenceFlow id="Flow_1fo6m6d" sourceRef="Gateway_0xnnfmp" targetRef="CT10" />
  </bpmn2:choreography>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Auto_Branched">
    <bpmndi:BPMNPlane id="BPMNPlane_Auto_Branched" bpmnElement="Choreo_Auto_Branched">
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="52" y="321" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="3282" y="338" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_AND_SPLIT_di" bpmnElement="G_AND_SPLIT" isMarkerVisible="true">
        <dc:Bounds x="1030" y="330" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1043" y="306" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_AND_JOIN_di" bpmnElement="G_AND_JOIN" isMarkerVisible="true">
        <dc:Bounds x="2000" y="330" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2013" y="306" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_OR_SPLIT_di" bpmnElement="G_OR_SPLIT" isMarkerVisible="true">
        <dc:Bounds x="2090" y="330" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_OR_JOIN_di" bpmnElement="G_OR_JOIN" isMarkerVisible="true">
        <dc:Bounds x="2400" y="330" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2372.5" y="348" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_XOR_di" bpmnElement="G_XOR" isMarkerVisible="true">
        <dc:Bounds x="2710" y="330" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2723" y="306" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CT1_di" bpmnElement="CT1">
        <dc:Bounds x="150" y="300" width="180" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CT1_top" bpmnElement="Part_PPS" isMessageVisible="true" participantBandKind="top_initiating" choreographyActivityShape="CT1_di">
        <dc:Bounds x="150" y="300" width="180" height="20" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CT1_bot" bpmnElement="Part_CellA" isMessageVisible="false" participantBandKind="bottom_non_initiating" choreographyActivityShape="CT1_di">
        <dc:Bounds x="150" y="390" width="180" height="20" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CT2_di" bpmnElement="CT2">
