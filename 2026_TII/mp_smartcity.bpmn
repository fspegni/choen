      <bpmn2:outgoing>Flow_0fv09ez</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_14c5112</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:parallelGateway id="G_AND_JOIN">
      <bpmn2:incoming>Flow_0zbutjn</bpmn2:incoming>
