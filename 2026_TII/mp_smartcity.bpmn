  <bpmn2:message id="Msg_Event" name="Urban Event Detected" />
  <bpmn2:message id="Msg_Traffic" name="Traffic Control Command" />
  <bpmn2:message id="Msg_Transit" name="Public Transport Update" />
  <bpmn2:message id="Msg_Verify" name="City Status Verification" />
  <bpmn2:message id="Msg_Lighting" name="Adjust Smart Lighting / Energy Profile" />
  <bpmn2:message id="Msg_Cleaning" name="Dispatch Cleaning &#38; Sanitation" />
  <bpmn2:message id="Msg_Patrol" name="Request Additional Safety Patrols" />
  <bpmn2:message id="Msg_ReVerify" name="Re-Verification Snapshot" />
  <bpmn2:message id="Msg_AlertPrep" name="Prepare Public Safety Alert" />
  <bpmn2:message id="Msg_AppAlert" name="Citizen App Push Alert" />
  <bpmn2:message id="Msg_Signage" name="Update Variable Message Signs" />
  <bpmn2:message id="Msg_Social" name="Post Social Media Alert" />
  <bpmn2:choreography id="Choreo_SmartCity_OR" name="Smart City Multi-Domain Choreography (AND / OR / XOR)">
    <bpmn2:participant id="Part_CityOps" name="City Operations Center" />
    <bpmn2:participant id="Part_IoT" name="Urban IoT Platform" />
    <bpmn2:participant id="Part_Traffic" name="Traffic Management System" />
    <bpmn2:participant id="Part_Transit" name="Public Transport Operator" />
    <bpmn2:participant id="Part_Energy" name="Smart Lighting &#38; Energy Platform" />
    <bpmn2:participant id="Part_Sanitation" name="Sanitation &#38; Cleaning Dispatch" />
    <bpmn2:participant id="Part_Safety" name="Public Safety Authority" />
    <bpmn2:participant id="Part_Citizen" name="Citizen Services Platform" />
    <bpmn2:participant id="Part_Signage" name="Digital Signage / VMS Network" />
    <bpmn2:participant id="Part_Social" name="Social Media Gateway" />
    <bpmn2:messageFlow id="MF1" sourceRef="Part_IoT" targetRef="Part_CityOps" messageRef="Msg_Event" />
