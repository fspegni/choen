      <bpmn2:outgoing>SF7</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:inclusiveGateway id="G_OR1_SPLIT" name="optional mitigations">
      <bpmn2:incoming>SF8</bpmn2:incoming>
      <bpmn2:outgoing>SF9C</bpmn2:outgoing>
