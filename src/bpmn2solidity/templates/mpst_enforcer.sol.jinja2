library Events {
	function eq(Event memory ev, ACTION action, ACTOR initiator, ACTOR target, MSG _msg) public pure returns (bool) {
		return ev.action == action && ev.initiator == initiator && ev.target == target && ev.label == _msg;
	}

	function contains(Event[] memory events, Event memory ev) public pure returns (bool) {
		for (uint idx=0; idx<events.length; idx++) {
			Event memory curr = events[idx];
			if (curr.action == ev.action && curr.initiator == ev.initiator && curr.target == ev.target && curr.label == ev.label) {
				return true;
			}
		}
		return false;
	}
}

